<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.czkuo.rdf88701.infra.mapper.ContainerDataHistoryMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.czkuo.rdf88701.infra.entity.ContainerDataHistory">
        <id     column="id"                 property="id" />
        <result column="origin_id"          property="originId" />
        <result column="container_main_id"  property="containerMainId" />
        <result column="ocr_text1"          property="ocrText1" />
        <result column="ocr_text2"          property="ocrText2" />
        <result column="estimated_quantity" property="estimatedQuantity" />
        <result column="verified_quantity"  property="verifiedQuantity" />

        <!-- ★ 三欄：工蓋 → 上蓋 → 一般 -->
        <result column="work_cover_layers"  property="workCoverLayers" />
        <result column="cover_layers"       property="coverLayers" />
        <result column="product_layers"     property="productLayers" />

        <result column="content_kind"       property="contentKind" />
        <result column="change_type"        property="changeType" />
        <result column="archived_time"      property="archivedTime" />
        <result column="operator"           property="operator" />
        <result column="remark"             property="remark" />
    </resultMap>

    <!-- 通用查询结果列（verified_quantity 後接：工蓋、上蓋、一般；再接 content_kind） -->
    <sql id="Base_Column_List">
        id, origin_id, container_main_id, ocr_text1, ocr_text2, estimated_quantity, verified_quantity,
        work_cover_layers, cover_layers, product_layers,
        content_kind, change_type, archived_time, operator, remark
    </sql>

    <insert id="batchInsert">
        INSERT INTO container_data_history (
            origin_id, container_main_id, ocr_text1, ocr_text2,
            estimated_quantity, verified_quantity,
            work_cover_layers, cover_layers, product_layers,
            content_kind, change_type, archived_time, operator, remark
        )
        VALUES
        <foreach collection="list" item="item" separator=",">
            (
                #{item.originId}, #{item.containerMainId}, #{item.ocrText1}, #{item.ocrText2},
                #{item.estimatedQuantity}, #{item.verifiedQuantity},
                #{item.workCoverLayers}, #{item.coverLayers}, #{item.productLayers},
                #{item.contentKind}, #{item.changeType}, #{item.archivedTime}, #{item.operator}, #{item.remark}
            )
        </foreach>
    </insert>

</mapper>
