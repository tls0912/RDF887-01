<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.czkuo.rdf88701.infra.mapper.AutoWalkConfigMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.czkuo.rdf88701.infra.entity.AutoWalkConfig">
        <id column="id" property="id" />
        <result column="strategy_code" property="strategyCode" />
        <result column="strategy_name" property="strategyName" />
        <result column="enabled" property="enabled" />
        <result column="container_limit" property="containerLimit" />
        <result column="excluded_container_ids"
                property="excludedContainerIds"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="extra_config"
                property="extraConfig"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="created_time" property="createdTime" />
        <result column="updated_time" property="updatedTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, strategy_code, strategy_name, enabled, container_limit, excluded_container_ids, extra_config, created_time, updated_time
    </sql>

    <!-- 查詢所有啟用的自走策略 -->
    <select id="selectEnabledConfigs" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM auto_walk_config
        WHERE enabled = 1
    </select>

</mapper>
